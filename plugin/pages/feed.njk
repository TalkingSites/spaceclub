---
# One Atom feed per entry in spaceclubFeeds (posts, events, each content type); see features.cjs
pagination:
  data: spaceclubFeeds
  size: 1
  alias: feed
permalink: "{{ feed.url }}"
eleventyExcludeFromCollections: true
---
{%- set base = site.url or "https://example.com/" -%}
{%- set entries = collections[feed.collection] | feedEntries -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>{{ site.title }}: {{ feed.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ feed.url | absoluteUrl(base) }}" rel="self"/>
  <link href="{{ base }}"/>
  <updated>{% if entries | length %}{{ entries[0] | entryDate | dateToRfc3339 }}{% else %}{{ page.date | dateToRfc3339 }}{% endif %}</updated>
  <id>{{ feed.url | absoluteUrl(base) }}</id>
  <author><name>{{ site.title }}</name></author>
  {%- for entry in entries %}
  {%- set url = entry.url | absoluteUrl(base) %}
  <entry>
    <title>{{ entry.data.title }}</title>
    <link href="{{ url }}"/>
    <updated>{{ entry | entryDate | dateToRfc3339 }}</updated>
    <id>{{ url }}</id>
    {%- if entry.data.description %}
    <summary>{{ entry.data.description }}</summary>
    {%- endif %}
    <content type="html">{{ entry.content | htmlToAbsoluteUrls(url) }}</content>
  </entry>
  {%- endfor %}
</feed>
