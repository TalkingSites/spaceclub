---
layout: base.njk
---
<article class="prose">
<h1>{{ title }}</h1>
<div class="post-meta">
{{ postDate | formatDate }}{% if author %} &nbsp;&middot;&nbsp; {{ author }}{% endif %}
</div>

{{ content | safe }}

{%- if gallery and not (content | hasGallery) %}
{% set path = gallery | stripLeadingSlash %}
{% include "partials/gallery.njk" %}
{%- endif %}

<div class="mt-5 pt-3">
<a href="/posts/" class="btn btn-outline-primary">All posts</a>
</div>
</article>
