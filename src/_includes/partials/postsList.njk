{% if type == "preview" %}
{% if excludeFeatured %}
{% set posts = collections.previewPosts %}
{% else %}
{% set posts = collections.previewPostsAll %}
{% endif %}
{% else %}
{% set posts = collections.posts %}
{% endif %}
{% if posts and posts | length > 0 %}
<div class="row row-gap-4">
{% for post in posts %}
<div class="col-12 col-md-6 col-lg-4">
<article class="panel post-card">
{% if post.data.image %}
<img src="{{ post.data.image }}" class="post-thumb" alt=""/>
{% endif %}
<h3>{{ post.data.title }}</h3>
{% if post.data.description %}
<p>{{ post.data.description }}</p>
{% endif %}
<div class="post-go">
{% if post.data.postDate %}<span class="post-date">{{ post.data.postDate | formatDate('DD MMM YYYY') }}</span>{% endif %}
<a class="stretched-link text-decoration-none text-reset" href="{{ post.data.permalink or post.url }}">{{ post.data.cta | default("Read") }}
<i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
</div>
</article>
</div>
{% endfor %}
</div>
{% if type == "preview" and collections.posts | length > posts | length %}
<div class="mt-4">
<a href="/posts/" class="btn btn-outline-primary">All {{ collections.posts | length }} posts</a>
</div>
{% endif %}
{% else %}
<p class="readout" style="padding:18px 0">Nothing published yet. The first one is being written.</p>
{% endif %}
